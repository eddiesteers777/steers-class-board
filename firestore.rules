rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // A teacher signs in with Google. Students playing a game get an anonymous guest sign-in
    // on their device (play.html), which can never reach a teacher's space.
    function google() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // Approved teachers only (early access). A Google account can use Anchor Board when it is the site
    // owner's, or when the owner approved its email on the Teacher access page (access.html), which
    // writes access/{email}. Any other Google account can still sign in, but reads and writes nothing:
    // the site sends it to waiting.html ("not on the list yet").
    // The owner is matched by a SHA-256 of the lowercase email, so the address is not in this public file.
    // Keep OWNER_HASHES in js/accessRules.js and functions/index.js the same.
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return google() && request.auth.token.email_verified == true; }
    function siteOwner() { return verified() && hashing.sha256(myEmail()).toHexString().lower() in [
        'f7765647c872fc9185968a516a7f6cefb0d9cd969eafa480429a37b9f3243e08'
    ]; }
    function approved() { return siteOwner() || (verified() && exists(/databases/$(database)/documents/access/$(myEmail()))); }
    function teacher() { return google() && approved(); }

    // Teacher-only school site. Each teacher account can read and write
    // ONLY its own documents under teacher/{uid}/...:
    //   teacher/{uid}/board/state   what the board is showing
    //   teacher/{uid}/ink/{key}     whiteboard drawings
    //   teacher/{uid}/games/room    a student game's full state, with answers and vault codes
    // Another Google account that signs in gets its own empty space and can
    // never see or change the teacher's board.
    match /teacher/{uid}/{doc=**} {
      allow read, write: if teacher() && request.auth.uid == uid;
    }

    // Other screens (tv.html, link.html): a TV, Chromebook or computer the teacher linked shows the board, read only.
    // The screen signs in as an anonymous guest and shows a short code; the teacher types or scans it on their own
    // signed-in device, which writes teacher/{uid}/tv/{screen's uid}. While that document is there, that one screen
    // can READ what the board shows (never grades, student work, plans or anything else) and can never write.
    // Deleting the document ("Stop showing" on link.html) cuts the screen off at once.
    function screenOf(uid) { return signedIn() && exists(/databases/$(database)/documents/teacher/$(uid)/tv/$(request.auth.uid)); }
    match /teacher/{uid}/tv/{me} {
      allow get: if signedIn() && request.auth.uid == me;   // the screen checks it is still linked
    }
    match /teacher/{uid}/{col}/{rest=**} {
      allow read: if col in ['board', 'ink', 'rosters', 'seats', 'settings', 'walk', 'games', 'slides', 'slideimg', 'weekfiles', 'bgimg']
        && screenOf(uid);
    }

    // Linking codes for other screens. pair/{code} is made by the screen (its own uid in tv), read by anyone signed in
    // who has the code, and claimed ONCE by a teacher within 30 minutes (adds owner). The screen deletes it once linked.
    match /pair/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['tv', 'at'])
        && request.resource.data.tv == request.auth.uid && request.resource.data.at == request.time;
      allow update: if teacher() && !('owner' in resource.data)
        && request.time < resource.data.at + duration.value(30, 'm')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner'])
        && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && (resource.data.tv == request.auth.uid || resource.data.get('owner', '') == request.auth.uid);
    }

    // Student games (Vault Raid). A room is found by its 6-digit code.
    //   rooms/{code}            status, title, the name list and the clock. Any guest with the code can read it.
    //   rooms/{code}/p/{who}    a student's own entry. Only that student writes it, while the game is open.
    //   rooms/{code}/s/{who}    what the teacher's Remote sends that one student. Only the teacher writes it.
    // The teacher who opened the room can read everything in it and delete it.
    match /rooms/{code} {
      function room() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
      function owner() { return teacher() && room().owner == request.auth.uid; }

      allow get: if signedIn();
      allow list: if false;
      allow create: if teacher() && code.matches('^[1-9][0-9]{5}$')
        && request.resource.data.owner == request.auth.uid;
      allow update: if teacher() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if teacher() && resource.data.owner == request.auth.uid;

      match /p/{who} {
        allow get: if signedIn() && (request.auth.uid == who || owner() || screenOf(room().owner));   // a linked screen shows the work pad the board shows
        allow list, delete: if owner();
        allow create, update: if signedIn() && request.auth.uid == who
          && room().status in ['lobby', 'play']
          && request.resource.data.keys().hasOnly(['at', 'ni', 'nm', 'code', 'cn', 'a', 'k', 'sb', 'img', 'iq', 'it', 'av', 'pu', 'vs', 'lk'])
          && (!('av' in request.resource.data) || (request.resource.data.av is int && request.resource.data.av >= 0 && request.resource.data.av < 32))
          && (!('vs' in request.resource.data) || (request.resource.data.vs is int && request.resource.data.vs >= 0 && request.resource.data.vs < 16))
          && (!('lk' in request.resource.data) || (request.resource.data.lk is string && request.resource.data.lk.size() <= 40 && request.resource.data.lk.matches('^([a-z][0-9a-z])*$')))
          && (!('pu' in request.resource.data) || (request.resource.data.pu is string && request.resource.data.pu.size() <= 12))
          && (!('nm' in request.resource.data) || (request.resource.data.nm is string && request.resource.data.nm.size() <= 24))
          && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 3))
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 400000))
          && (!('a' in request.resource.data) || (request.resource.data.a is map && request.resource.data.a.keys().hasOnly(['n', 'q', 't'])
                && request.resource.data.a.t is string && request.resource.data.a.t.size() <= 80))
          && (!('k' in request.resource.data) || (request.resource.data.k is map && request.resource.data.k.keys().hasOnly(['n', 'to', 'g'])))
          && (!('sb' in request.resource.data) || (request.resource.data.sb is map && request.resource.data.sb.keys().hasOnly(['n', 'to', 'k'])
                && request.resource.data.sb.k is string && request.resource.data.sb.k.size() <= 8));
      }
      match /s/{who} {
        allow get: if signedIn() && (request.auth.uid == who || owner());
        allow list, write: if owner();
      }
    }

    // Assignments (assign.html for the teacher, do.html for students). Found by a 6-digit code, like a game room.
    //   asg/{code}          title, the name list and the problems. No answer key for quizzes and tests.
    //   asg/{code}/p/{who}  a student's own entry: which name they picked and every attempt. Only that student
    //                       writes it, only while the assignment is open (and before the due time when it locks),
    //                       only these fields, and never again once a quiz or test is turned in.
    //   asg/{code}/r/{who}  a quiz or test result the teacher released. Only the teacher writes it.
    // The teacher who made the assignment can read everything in it and delete it.
    match /asg/{code} {
      function asg() { return get(/databases/$(database)/documents/asg/$(code)).data; }
      function asgOwner() { return teacher() && asg().owner == request.auth.uid; }
      function asgOpen() { return asg().status == 'open' && (asg().lock != true || request.time.toMillis() < asg().due); }

      allow get: if signedIn();
      allow list: if false;
      allow create: if teacher() && code.matches('^[1-9][0-9]{5}$')
        && request.resource.data.owner == request.auth.uid && request.resource.data.kind == 'asg';
      allow update: if teacher() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if teacher() && resource.data.owner == request.auth.uid;

      match /p/{who} {
        allow get: if signedIn() && (request.auth.uid == who || asgOwner());
        allow list, delete: if asgOwner();
        allow create, update: if signedIn() && request.auth.uid == who && asgOpen()
          && (resource == null || resource.data.get('done', false) != true)
          && request.resource.data.keys().hasOnly(['per', 'ni', 'nm', 'at', 'lg', 'ans', 'done', 'sub'])
          && request.resource.data.per is string && request.resource.data.per.size() <= 12
          && request.resource.data.ni is int && request.resource.data.ni >= -1 && request.resource.data.ni < 80
          && (!('nm' in request.resource.data) || (request.resource.data.nm is string && request.resource.data.nm.size() <= 24))
          && (!('lg' in request.resource.data) || (request.resource.data.lg is list && request.resource.data.lg.size() <= 600))
          && (!('ans' in request.resource.data) || (request.resource.data.ans is map && request.resource.data.ans.size() <= 60))
          && (!('done' in request.resource.data) || request.resource.data.done is bool);
      }
      match /r/{who} {
        allow get: if signedIn() && (request.auth.uid == who || asgOwner());
        allow list, write: if asgOwner();
      }
    }

    // Fact Blitz (fluency.html for the teacher, fact.html for students): a timed fact fluency check. Found by a 6-digit code.
    //   flu/{code}          title, the fact set, the clock, the goal and the name list. Any guest with the code can read it.
    //   flu/{code}/p/{who}  a student's own entry: the name they picked and their runs (each run's log of facts, answers
    //                       and times). Only that student writes it, only while the check is open, only these fields.
    //   flu/{code}/s/{who}  what the teacher's page sends that one student: their clock (extra time) and how many check
    //                       tries they have. Only the teacher writes it, so which students have extra time is never public.
    // The teacher who opened it can read everything in it and delete it. The teacher's page scores every run from its log.
    match /flu/{code} {
      function flu() { return get(/databases/$(database)/documents/flu/$(code)).data; }
      function fluOwner() { return teacher() && flu().owner == request.auth.uid; }

      allow get: if signedIn();
      allow list: if false;
      allow create: if teacher() && code.matches('^[1-9][0-9]{5}$')
        && request.resource.data.owner == request.auth.uid && request.resource.data.kind == 'flu';
      allow update: if teacher() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if teacher() && resource.data.owner == request.auth.uid;

      match /p/{who} {
        allow get: if signedIn() && (request.auth.uid == who || fluOwner());
        allow list, delete: if fluOwner();
        allow create, update: if signedIn() && request.auth.uid == who && flu().status == 'open'
          && request.resource.data.keys().hasOnly(['per', 'ni', 'nm', 'at', 'runs'])
          && request.resource.data.per is string && request.resource.data.per.size() <= 12
          && request.resource.data.ni is int && request.resource.data.ni >= -1 && request.resource.data.ni < 80
          && (!('nm' in request.resource.data) || (request.resource.data.nm is string && request.resource.data.nm.size() <= 24))
          && (!('runs' in request.resource.data) || (request.resource.data.runs is list && request.resource.data.runs.size() <= 30));
      }
      match /s/{who} {
        allow get: if signedIn() && (request.auth.uid == who || fluOwner());
        allow list, write: if fluOwner();
      }
    }

    // Class Pages (class.html): the student version of each approved week, for students and parents.
    // Anyone can read it without signing in; only that teacher writes it (Week Review's Approve).
    // It never holds answers, keys or any student information (js/publish.js strips them).
    //   pub/{uid}                 the list of posted weeks and the class labels (the index)
    //   pub/{uid}/weeks/{weekId}  one week's student version for each class
    match /pub/{uid}/{doc=**} {
      allow read: if true;
      allow write: if teacher() && request.auth.uid == uid;
    }

    // Early access sign-ups from the public site (site/join.html). Anyone can add one
    // well-formed entry; nobody can read, change or delete the list from the web.
    // The site owner reads it on the Teacher access page (access.html) and can clear an entry.
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['grades', 'subject', 'board', 'device', 'email', 'name', 'note', 'at'])
        && request.resource.data.keys().hasAll(['grades', 'board', 'device', 'email', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.grades in ['elementary', 'middle', 'high', 'other']
        && request.resource.data.board in ['promethean', 'smart', 'projector', 'tv']
        && request.resource.data.device in ['chromebook', 'laptop', 'ipad', 'phone']
        && (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 60))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40))
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      allow read, delete: if siteOwner();
      allow update: if false;
    }

    // The approved list (access.html). Only the owner reads or changes it. A signed-in teacher can check
    // their own entry (that is how the site knows to show waiting.html), nobody else's.
    //   access/{email}   { email, at, from: "added" | "waitlist", note? }   the id is the lowercase email
    match /access/{email} {
      allow get: if siteOwner() || (verified() && email == myEmail());
      allow list, delete: if siteOwner();
      allow create, update: if siteOwner()
        && email.matches('^[^@ A-Z]+@[^@ A-Z]+[.][^@ A-Z]+$') && email.size() <= 120
        && request.resource.data.keys().hasOnly(['email', 'at', 'from', 'note'])
        && request.resource.data.email == email
        && request.resource.data.at == request.time
        && request.resource.data.from in ['added', 'waitlist']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 80));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
