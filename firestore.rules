rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Teacher-only school site. Each signed-in account can read and write
    // ONLY its own documents under teacher/{uid}/...:
    //   teacher/{uid}/board/state   what the board is showing
    //   teacher/{uid}/ink/{key}     whiteboard drawings
    // Another Google account that signs in gets its own empty space and can
    // never see or change the teacher's board. Students never sign in.
    match /teacher/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
