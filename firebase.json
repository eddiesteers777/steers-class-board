{
  "hosting": [
    {
      "site": "anchorboard",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "firestore.rules",
        "hosting-redirect/**",
        "**/*.md",
        "**/*.log",
        "**/*.patch",
        "tools/**",
        "functions/**",
        "connector/**"
      ],
      "redirects": [
        {
          "source": "/play",
          "destination": "/play.html",
          "type": 301
        },
        {
          "source": "/join",
          "destination": "/play.html",
          "type": 301
        },
        {
          "source": "/do",
          "destination": "/do.html",
          "type": 301
        }
      ]
    },
    {
      "site": "steers-class-board",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "firestore.rules",
        "hosting-redirect/**",
        "**/*.md",
        "**/*.log",
        "**/*.patch",
        "tools/**",
        "functions/**",
        "connector/**"
      ],
      "redirects": [
        {
          "source": "/play",
          "destination": "/play.html",
          "type": 301
        },
        {
          "source": "/join",
          "destination": "/play.html",
          "type": 301
        },
        {
          "source": "/do",
          "destination": "/do.html",
          "type": 301
        }
      ]
    },
    {
      "site": "focalboard",
      "public": "hosting-redirect",
      "redirects": [
        {
          "regex": "^/(?P<rest>.*)$",
          "destination": "https://anchorboard.web.app/:rest",
          "type": 301
        }
      ]
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
