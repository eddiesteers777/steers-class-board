{
  "hosting": [
    {
      "site": "focalboard",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/play",
          "destination": "/play.html",
          "type": 301
        },
        {
          "source": "/join",
          "destination": "/play.html",
          "type": 301
        }
      ]
    },
    {
      "site": "steers-class-board",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/play",
          "destination": "/play.html",
          "type": 301
        },
        {
          "source": "/join",
          "destination": "/play.html",
          "type": 301
        }
      ]
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
